#!/bin/sh

# Register the theme so it shows up under System > System > Language and Style.
# It is NOT made the default automatically on upgrade; pick it in the UI
# (or run: uci set luci.main.mediaurlbase=/luci-static/synthwave && uci commit luci).

if ! uci -q get luci.themes.Synthwave >/dev/null 2>&1; then
	uci set luci.themes.Synthwave=/luci-static/synthwave
	uci commit luci
fi

exit 0
